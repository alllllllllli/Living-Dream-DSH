# ============================================================
# DSH Ultra Config - API Key 配置模板
# ============================================================
# 复制到 ~/.dsh/.credentials.yaml
# 填入你的实际 API Key
# ⚠️ 不要提交此文件到 Git！
# ============================================================

# DeepSeek API Key（可选，用于官方 API）
DEEPSEEK_API_KEY: your-deepseek-api-key

# AMD Radeon Cloud API Key（免费）
# 注册：developer.amd.com.cn/radeon
AMD_RADEON_API_KEY: your-amd-api-key

# OpenCode Go API Key
OPENCODE_GO_API_KEY: your-opencode-go-api-key

# CNB API Key（免费）
# 注册：cnb.cool
CNB_API_KEY: your-cnb-api-key

# CNB 仓库（免费模型代理用，格式 组织名/仓库名）
# ⚠️ 必须是私有仓库：代理会在里面创建/关闭 Issue，公开仓库会泄露对话内容
CNB_REPO: your-org/your-repo

# 智谱 AI API Key（用于 GLM-4V-Flash 视觉识别）
# 注册：open.bigmodel.cn
VISION_API_KEY: your-zhipu-api-key
