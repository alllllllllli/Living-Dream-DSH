# ============================================================
# DSH Ultra Config - MCP 配置模板
# ============================================================
# 复制到 ~/.dsh/profiles/web/cordis.patch.yml
# 一键安装脚本会自动替换路径占位符，手动安装需自行修改
# ============================================================

# ============ dsh 全家桶 MCP ============

# 1. 历史会话查询: list_sessions / get_session / search_history
- insert:
    - id: mcp-dsh-history
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: dsh-history
        command: python
        args:
          - scripts/mcp/dsh-history-server.py  # 相对于仓库根目录，安装脚本自动替换为绝对路径
        env: {}
        cwd: ''
        toolCallTimeoutMs: 60000
        failOnStartupError: false

# 2. 看图: describe_image (本地 Ollama qwen2.5vl)
- insert:
    - id: mcp-dsh-vision
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: dsh-vision
        command: python
        args:
          - scripts/mcp/dsh-vision-server.py
        env:
          # Ollama 端点（默认 localhost:11434，可改为远程地址）
          OLLAMA_HOST: http://localhost:11434
          # 视觉模型（默认 qwen2.5vl:latest，按已安装模型修改）
          VISION_MODEL: qwen2.5vl:latest
        cwd: ''
        toolCallTimeoutMs: 240000
        failOnStartupError: false

# 3. 屏幕操作: computer-use (截屏/点击/键鼠) — 开源替代
- insert:
    - id: mcp-dsh-computer
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: dsh-computer
        command: npx
        args:
          - "--yes"
          - "--prefer-offline"
          - "@zavora-ai/computer-use-mcp"
        env: {}
        cwd: ''
        toolCallTimeoutMs: 120000
        failOnStartupError: false

# 3.5 代码执行: OS-Copilot (Python/Shell/文件操作)
- insert:
    - id: mcp-os-copilot
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: os-copilot
        command: python
        args:
          - scripts/mcp/os-copilot-server.py
        env: {}
        cwd: ''
        toolCallTimeoutMs: 60000
        failOnStartupError: false

# 4. 浏览器: Playwright MCP (--extension 模式: 连接正在运行的 Edge, 真实 profile/登录态)
- insert:
    - id: mcp-dsh-browser
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: dsh-browser
        command: npx
        args:
          - "--yes"
          - "@playwright/mcp"
          - --browser
          - msedge
          - --extension
        env: {}
        cwd: ''
        toolCallTimeoutMs: 120000
        failOnStartupError: false

# 5. 长期记忆: remember / recall / forget / list_memories
- insert:
    - id: mcp-dsh-memory
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: dsh-memory
        command: python
        args:
          - scripts/mcp/dsh-memory-server.py
        env: {}
        cwd: ''
        toolCallTimeoutMs: 120000
        failOnStartupError: false

# 6. 文件转换: convert_to_markdown (PDF/Word/Excel/PPT/EPUB/HTML 等转 Markdown)
#    依赖: pip install markitdown
- insert:
    - id: mcp-dsh-markitdown
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: dsh-markitdown
        command: python
        args:
          - scripts/mcp/dsh-markitdown-server.py
        env: {}
        cwd: ''
        toolCallTimeoutMs: 120000
        failOnStartupError: false

# 7. 屏幕 OCR: ocr_screen / ocr_region / ocr_screen_text (Windows.Media.Ocr 离线识别)
- insert:
    - id: mcp-dsh-ocr
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: dsh-ocr
        command: python
        args:
          - scripts/mcp/dsh-ocr-server.py
        env: {}
        cwd: ''
        toolCallTimeoutMs: 120000
        failOnStartupError: false

