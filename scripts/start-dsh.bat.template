@echo off
:: ============================================================
:: Living Dream DSH - Launcher
:: ============================================================
:: Auto-detects DSH Desktop from:
::   1. DSH_DESKTOP_PATH environment variable
::   2. Common install locations
::   3. Edit the path below if auto-detect fails
:: ============================================================

setlocal enabledelayedexpansion

:: ============================================================
:: Auto-detect DSH Desktop path
:: ============================================================

set "DSH_EXE="

:: 1. Check DSH_DESKTOP_PATH env var
if defined DSH_DESKTOP_PATH (
    if exist "%DSH_DESKTOP_PATH%\DeepSeekHarness.exe" (
        set "DSH_EXE=%DSH_DESKTOP_PATH%\DeepSeekHarness.exe"
        goto :found
    )
    if exist "%DSH_DESKTOP_PATH%\DeepSeek Harness 桌面版.exe" (
        set "DSH_EXE=%DSH_DESKTOP_PATH%\DeepSeek Harness 桌面版.exe"
        goto :found
    )
)

:: 2. Common install locations
for %%P in (
    "%ProgramFiles%\DeepSeekHarness-Desktop\DeepSeekHarness.exe"
    "%ProgramFiles%\DeepSeek-Harness-Desktop\DeepSeek Harness 桌面版.exe"
    "%LOCALAPPDATA%\DeepSeekHarness-Desktop\DeepSeekHarness.exe"
    "D:\Tools\DeepSeekHarness-Desktop\DeepSeekHarness.exe"
    "D:\Tools\DeepSeek-Harness-Desktop\DeepSeek Harness 桌面版.exe"
    "C:\Tools\DeepSeekHarness-Desktop\DeepSeekHarness.exe"
) do (
    if exist %%P (
        set "DSH_EXE=%%~P"
        goto :found
    )
)

:: 3. Not found — ask user to edit
echo [ERROR] DSH Desktop not found!
echo [INFO] Set DSH_DESKTOP_PATH env var to your install directory, or edit this script.
echo [INFO] Example: set DSH_DESKTOP_PATH=D:\Tools\DeepSeekHarness-Desktop
pause
exit /b 1

:found
echo [DSH] Starting: !DSH_EXE!
start "" "!DSH_EXE!"

echo [DSH] Done!
echo.
echo [INFO] Access DSH at: http://127.0.0.1:3080
echo [INFO] Press any key to exit this window...
pause >nul
