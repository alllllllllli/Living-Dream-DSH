@echo off
:: ============================================================
:: Living Dream DSH - Launcher Template
:: ============================================================
:: Auto-detect CNB Proxy and start DSH Desktop
:: Copy to your DSH directory and customize paths
:: ============================================================

setlocal enabledelayedexpansion

:: ============================================================
:: Configuration - Customize these paths
:: ============================================================

:: DSH Desktop executable path
:: Option 1: Default installation path
:: set "DSH_EXE=%ProgramFiles%\DeepSeek Harness\DeepSeek Harness 桌面版.exe"
:: Option 2: Custom installation path (uncomment and modify)
set "DSH_EXE=D:\ToolsDeepSeek-Harness-Desktop\DeepSeek Harness 桌面版.exe"

:: CNB Proxy script path
set "CNB_PROXY=%~dp0cnb_proxy.py"
set "CNB_PORT=8800"

:: ============================================================
:: Auto-detect and start
:: ============================================================

:: Check if DSH Desktop exists
if not exist "%DSH_EXE%" (
    echo [ERROR] DSH Desktop not found: %DSH_EXE%
    echo [INFO] Please modify DSH_EXE path in this script
    pause
    exit /b 1
)

:: Check if CNB Proxy is running
echo [DSH] Checking CNB Proxy on port %CNB_PORT%...
netstat -an | findstr ":%CNB_PORT% " | findstr "LISTENING" >nul 2>&1
if %errorlevel% neq 0 (
    echo [DSH] CNB Proxy not running, starting...
    if exist "%CNB_PROXY%" (
        start /b python "%CNB_PROXY%" --port %CNB_PORT%
        timeout /t 2 /nobreak >nul
        echo [DSH] CNB Proxy started
    ) else (
        echo [WARN] CNB Proxy script not found: %CNB_PROXY%
        echo [INFO] Free model access will not be available
    )
) else (
    echo [DSH] CNB Proxy already running
)

:: Start DSH Desktop
echo [DSH] Starting DeepSeek Harness Desktop...
start "" "%DSH_EXE%"

echo [DSH] Done!
echo.
echo [INFO] Access DSH at: http://127.0.0.1:3080
echo [INFO] Press any key to exit this window...
pause >nul
