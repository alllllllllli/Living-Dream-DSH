@echo off
:: ============================================================
:: Living Dream DSH - Launcher Template
:: ============================================================
:: Start DSH Desktop
:: Copy to your DSH directory and customize paths
:: ============================================================

setlocal enabledelayedexpansion

:: ============================================================
:: Configuration - Customize these paths
:: ============================================================

:: DSH Desktop executable path
:: Option 1: Default installation path
:: set "DSH_EXE=%ProgramFiles%\DeepSeek Harness\DeepSeek Harness 桌面版.exe"
:: Option 2: Custom installation path (uncomment and modify)
set "DSH_EXE=D:\Tools\DeepSeek-Harness-Desktop\DeepSeek Harness 桌面版.exe"

:: ============================================================
:: Start DSH Desktop
:: ============================================================

:: Check if DSH Desktop exists
if not exist "%DSH_EXE%" (
    echo [ERROR] DSH Desktop not found: %DSH_EXE%
    echo [INFO] Please modify DSH_EXE path in this script
    pause
    exit /b 1
)

:: Start DSH Desktop
echo [DSH] Starting DeepSeek Harness Desktop...
start "" "%DSH_EXE%"

echo [DSH] Done!
echo.
echo [INFO] Access DSH at: http://127.0.0.1:3080
echo [INFO] Press any key to exit this window...
pause >nul
